<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Places from Google Maps: Share → Majula on a listing (docs/modules/places.md 15).
              Android cannot filter text shares by their content, so Majula is offered for any
              text; the web layer accepts only Google Maps links and refuses the rest.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!--
      INTERNET is deliberately not declared. ADR-003 and SPECS §6 make offline the only
      mode, and without the permission Android enforces it. The app still loads: Capacitor
      serves it from https://localhost by answering every request inside the WebView, so no
      socket is ever opened (DECISIONS.md, 2026-09-23).

      @capacitor-community/sqlite merges in the biometric permissions for its locked
      databases. SPECS §1.1 item 4 rules out credentials of any kind, so they are removed.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!--
      Places: the Here button (SPECS §2.1, docs/modules/places.md). Requested at runtime the
      first time Here is tapped, never at install. Android 12 and later require COARSE to be
      declared alongside FINE, and let the owner grant only the approximate one; the screen
      shows the fix's accuracy so that choice is visible.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
