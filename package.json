{
  "name": "majula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && cd android && .\\gradlew.bat assembleDebug",
    "install:apk": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@preact/preset-vite": "^2.10.6",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
